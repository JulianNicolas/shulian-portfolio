---
import Base from '../layouts/Base.astro';
---

<Base>
  <header class="bar">
    <div class="wrap bar-in">
      <span class="wordmark">shulian<span class="dot">.</span>dev</span>
      <nav class="top">
        <a href="#work" class="nav-hide">Work</a>
        <a href="#stack" class="nav-hide">Stack</a>
        <a href="#path" class="nav-hide">Path</a>
        <a href="#contact">Contact</a>
        <button class="theme-btn" id="themeBtn" type="button" aria-label="Toggle color theme">◑ theme</button>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="hero" id="top">
      <h1>Julián Antonucci</h1>
      <p class="role">
        Senior backend engineer with <b>7+ years</b> building <b>Node.js</b> and <b>Python</b> systems
        that hold up under real load — <b>distributed systems</b>, <b>high-throughput APIs</b>, and
        pragmatic <b>AWS</b>.
      </p>

      <div class="facts">
        <div class="fact">
          <div class="k mono">Now</div>
          <div class="v">
            Most recently 5 years as Senior Software Engineer at NewCombin, on high-traffic systems for
            US broadcast &amp; media clients. Currently leading <a href="#work">ink-cover</a>'s AWS
            migration independently.
          </div>
        </div>
        <div class="fact">
          <div class="k mono">Stack</div>
          <div class="v mono">Node.js · TypeScript · Python · PostgreSQL · Redis · RabbitMQ · AWS (Lambda · SQS · EC2 · S3 · CloudFront)</div>
        </div>
        <div class="fact">
          <div class="k mono">Based</div>
          <div class="v">Remote-first · open to relocation, flexible across US time zones</div>
        </div>
        <div class="fact">
          <div class="k mono">Links</div>
          <div class="v">
            <a href="https://github.com/JulianNicolas">GitHub</a> &nbsp;·&nbsp;
            <a href="https://www.linkedin.com/in/julian-antonucci/">LinkedIn</a> &nbsp;·&nbsp;
            <a href="#contact">CV (PDF)</a> &nbsp;·&nbsp;
            <a href="mailto:antonuccijulian@gmail.com">Email</a>
          </div>
        </div>
      </div>
    </section>

    <section id="work">
      <p class="eyebrow">Selected work</p>

      <!-- CASE 1 — NewCombin -->
      <article class="case">
        <div class="case-body">
          <div class="case-head">
            <h3>Real-time voting platform — race condition at scale</h3>
            <span class="when mono">2021 – 2026 · NewCombin</span>
          </div>
          <p class="lede">
            Primary backend engineer on a high-traffic survey and voting platform built for major US
            broadcast networks. During live broadcast events — the exact moment traffic peaks — votes
            were silently disappearing.
          </p>

          <h4>What broke</h4>
          <p class="para">
            A legacy DynamoDB-to-MySQL migration had left a race condition in the vote-write path.
            Under the concurrent write volume of a live broadcast, writes overlapped and votes were
            lost with no error, no alert — just a count that didn't add up after the show aired.
          </p>

          <h4>What I did</h4>
          <ul>
            <li>
              Traced the loss to the migration's overlapping writes and rebuilt the path around
              Redis-based vote buffering, collapsing concurrent increments into atomic operations
              before they ever reached MySQL.
            </li>
            <li>
              Optimized the critical queries in the read/aggregation path and configured CPU-based EC2
              autoscaling to absorb live-broadcast traffic spikes.
            </li>
            <li>
              Validated the fix with JMeter load tests at 30,000 votes/minute — zero data loss, a 5x
              increase in processing capacity over the previous ceiling.
            </li>
            <li>
              Removed the dead code left over from the original migration once the new path proved out
              in production, closing off a source of latent bugs.
            </li>
            <li>
              Built and extended the platform's social distribution integrations (Instagram, TikTok,
              Facebook, Vimeo) for direct video/image publishing from its media management platform.
            </li>
          </ul>
        </div>

        <aside class="panel">
          <div class="panel-card">
            <div class="panel-row">
              <span class="m-k mono">Load validated</span>
              <span class="m-v">30,000 votes/min · JMeter</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Data loss</span>
              <span class="m-v">race condition <span class="arrow">→</span> 0%</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Capacity</span>
              <span class="m-v">5x increase</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Role</span>
              <span class="m-v">Primary backend engineer</span>
            </div>
            <div class="stacklist">
              <span class="chip">Node.js</span><span class="chip">MySQL</span><span class="chip">DynamoDB</span>
              <span class="chip">Redis</span><span class="chip">AWS EC2</span><span class="chip">JMeter</span>
            </div>
          </div>
        </aside>
      </article>

      <!-- CASE 2 — ink-cover -->
      <article class="case">
        <div class="case-body">
          <div class="case-head">
            <h3>ink-cover — serverless migration</h3>
            <span class="when mono">2025 – present · Independent</span>
          </div>
          <p class="lede">
            A Node.js/TypeScript product that turns uploaded images into analysis reports. I lead the
            backend and I'm moving the whole platform off one droplet onto AWS serverless while it
            keeps serving traffic.
          </p>

          <h4>Where it started</h4>
          <p class="para">
            A single DigitalOcean droplet ran the API, the Postgres database and image processing
            together. Deploys were a <code>git push</code> that SSH'd into the box — no CI gate, no
            rollback, no preview. Every upload processed synchronously, so traffic spikes queued
            behind image work and the API slowed for everyone.
          </p>

          <div
            class="arch"
            role="img"
            aria-label="Architecture before and after: a single droplet running API, Postgres and image processing becomes CloudFront in front of an App Runner API, a container-image Lambda worker behind SQS, serverless Postgres on Neon, S3 for image bytes, and EventBridge routing completion events to SES — the whole stack defined in AWS CDK."
          >
            <div class="arch-grid">
              <div class="arch-col before">
                <h5>Before</h5>
                <div class="flow">
                  <div class="node">client</div>
                  <div class="link-v"></div>
                  <div class="node hot">1× droplet<br />API + Postgres + image proc</div>
                  <div class="link-v"></div>
                  <div class="node hot">base64 blobs in DB</div>
                </div>
              </div>
              <div class="arch-col after">
                <h5>After — target</h5>
                <div class="flow">
                  <div class="node">client</div>
                  <div class="link-v"></div>
                  <div class="node">CloudFront · ACM · Route 53</div>
                  <div class="link-v"></div>
                  <div class="node key">App Runner · API</div>
                  <div class="link-v"></div>
                  <div class="split">
                    <div class="node key">SQS → Lambda worker<br /><span class="mono" style="font-size:0.68rem">container image</span></div>
                    <div class="node">Neon<br /><span class="mono" style="font-size:0.68rem">serverless Postgres</span></div>
                  </div>
                  <div class="link-v"></div>
                  <div class="split">
                    <div class="node key">S3<br /><span class="mono" style="font-size:0.68rem">image + preview bytes</span></div>
                    <div class="node">EventBridge → SES<br /><span class="mono" style="font-size:0.68rem">completion notify</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <h4>What I did</h4>
          <ul>
            <li>
              Introduced a <code>StoragePort</code> interface with an <code>S3Storage</code>
              implementation, moving image and preview bytes out of Postgres and onto S3. Read paths
              now serve signed URLs instead of base64 payloads.
            </li>
            <li>
              Added <code>previewKey</code> / <code>imageKey</code> columns plus a backfill, and
              relaxed the legacy <code>base64 NOT NULL</code> constraint so old and new rows coexist
              through the cutover.
            </li>
            <li>
              Redesigned the analysis pipeline around a <code>Queue</code> port with a pluggable
              backend — one Postgres implementation today (<code>LISTEN</code>/<code>NOTIFY</code> +
              <code>FOR UPDATE SKIP LOCKED</code>), one SQS implementation for AWS, same worker code
              either way.
            </li>
            <li>
              Designed the target AWS architecture end to end in CDK: App Runner for the API, the
              existing worker Docker image redeployed as a container-image Lambda behind SQS,
              EventBridge routing job-completion events to SES for email notifications, and Neon
              (serverless Postgres) in place of a managed instance.
            </li>
            <li>
              Killed a class of "stale app after deploy" bugs — a cached <code>index.html</code> and
              orphaned service workers that kept serving a months-old bundle to returning users.
            </li>
          </ul>

          <h4>Architecture decisions</h4>
          <ul>
            <li>
              <b>App Runner over API Gateway + Lambda</b> for the API — the request path is rarely
              idle at this traffic, so a container that autoscales on its own beats paying Lambda's
              cold-start tax on every request.
            </li>
            <li>
              <b>Neon over RDS</b> — at this volume an always-on managed instance would cost more than
              the workload itself; Neon bills for compute actually used and scales to zero between
              requests.
            </li>
            <li>
              <b>No VPC, no NAT gateway</b> — App Runner, the worker Lambda and Neon all talk over
              public TLS endpoints. A private database would have forced a NAT gateway that alone
              costs more than the database.
            </li>
            <li>
              <b>Worker ships as the same container image</b> the droplet ran, redeployed to Lambda —
              no parallel build pipeline to maintain for two runtimes.
            </li>
          </ul>
        </div>

        <aside class="panel">
          <div class="panel-card">
            <div class="panel-row">
              <span class="m-k mono">Impact</span>
              <span class="m-v">Zero-downtime cutover, in progress</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Upload p95</span>
              <span class="m-v slot mono">sync → async · add metric</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Infra cost / mo</span>
              <span class="m-v slot mono">DO $XX <span class="arrow">→</span> AWS $YY</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Deploy safety</span>
              <span class="m-v">manual SSH <span class="arrow">→</span> CI + preview</span>
            </div>
            <div class="panel-row">
              <span class="m-k mono">Role</span>
              <span class="m-v">Lead backend engineer</span>
            </div>
            <div class="stacklist">
              <span class="chip">Node.js</span><span class="chip">TypeScript</span><span class="chip">TypeORM</span>
              <span class="chip">Postgres</span><span class="chip">Neon</span><span class="chip">AWS S3</span>
              <span class="chip">SQS</span><span class="chip">Lambda</span><span class="chip">App Runner</span>
              <span class="chip">EventBridge</span><span class="chip">SES</span><span class="chip">CloudFront</span>
              <span class="chip">CDK</span>
            </div>
          </div>
        </aside>
      </article>

      <!-- CASE 3 — Verdant Solution -->
      <article class="case">
        <div class="case-body">
          <div class="case-head">
            <h3>Print optimization platform — microservices architecture</h3>
            <span class="when mono">2016 – 2022 · Verdant Solution</span>
          </div>
          <p class="lede">
            Co-founded a software studio serving the graphic arts industry and designed its flagship
            product: a print optimization system that lays out jobs to minimize material waste.
          </p>
          <h4>What I did</h4>
          <ul>
            <li>
              Designed a microservices architecture: a Node.js/TypeScript backend orchestrating async
              PDF generation jobs over RabbitMQ, and a Python microservice using Ghostscript to compute
              layouts that minimize material waste.
            </li>
            <li>Built real-time order-status updates over WebSockets and moved generated artifacts to S3.</li>
            <li>Cut PDF data-extraction time 75% with a Node.js REST API backed by the Python microservice.</li>
            <li>
              Cut internal approval-workflow completion time 50% by replacing polling with real-time
              WebSocket (Socket.IO) file flows.
            </li>
            <li>Cut local environment setup time 40% by containerizing the stack with Docker and managing processes with PM2.</li>
          </ul>
        </div>
        <aside class="panel">
          <div class="panel-card">
            <div class="panel-row"><span class="m-k mono">PDF extraction</span><span class="m-v">−75% time</span></div>
            <div class="panel-row"><span class="m-k mono">Approval workflow</span><span class="m-v">−50% time</span></div>
            <div class="panel-row"><span class="m-k mono">Env setup</span><span class="m-v">−40% time</span></div>
            <div class="panel-row"><span class="m-k mono">Role</span><span class="m-v">Co-founder · backend &amp; architecture</span></div>
            <div class="stacklist">
              <span class="chip">Node.js</span><span class="chip">Python</span><span class="chip">RabbitMQ</span>
              <span class="chip">Ghostscript</span><span class="chip">WebSockets</span><span class="chip">Docker</span>
              <span class="chip">AWS S3</span>
            </div>
          </div>
        </aside>
      </article>
    </section>

    <section id="stack">
      <p class="eyebrow">Stack</p>
      <div class="stack-grid">
        <div class="stack-col">
          <h3>Runtime</h3>
          <ul>
            <li>Node.js <span>— core</span></li>
            <li>TypeScript <span>— strict</span></li>
            <li>Python <span>— Django</span></li>
            <li>NestJS / Express</li>
            <li>Jest <span>— unit · integration</span></li>
          </ul>
        </div>
        <div class="stack-col">
          <h3>Data</h3>
          <ul>
            <li>PostgreSQL <span>— primary · Neon serverless</span></li>
            <li>MySQL · DynamoDB · MongoDB</li>
            <li>Redis <span>— cache · buffering</span></li>
            <li>RabbitMQ <span>— messaging</span></li>
            <li>TypeORM · Sequelize · Drizzle</li>
          </ul>
        </div>
        <div class="stack-col">
          <h3>AWS</h3>
          <ul>
            <li>EC2 · App Runner <span>— API</span></li>
            <li>Lambda <span>— container-image worker</span></li>
            <li>SQS · SNS · EventBridge · SES</li>
            <li>S3 · CloudFront · Route 53</li>
            <li>CodeDeploy · IAM · CDK</li>
          </ul>
        </div>
        <div class="stack-col">
          <h3>Delivery</h3>
          <ul>
            <li>Docker · Docker Compose · PM2</li>
            <li>GitHub Actions · Bitbucket Pipelines</li>
            <li>Observability <span>— Sentry · CloudWatch</span></li>
            <li>Load &amp; failure testing <span>— JMeter</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="path">
      <p class="eyebrow">Path</p>
      <div class="path">
        <div class="stop">
          <div class="yr">2025 — now</div>
          <div class="role">
            <b>Independent Backend Engineer</b> · <span class="co">ink-cover</span>
            <p>
              Own the backend for a graphic-arts SaaS product — leading its migration off a single
              droplet onto an AWS event-driven architecture (SQS, Lambda, App Runner, CDK).
            </p>
          </div>
        </div>
        <div class="stop">
          <div class="yr">2021 — 2026</div>
          <div class="role">
            <b>Senior Software Engineer</b> · <span class="co">NewCombin</span>
            <p>
              Primary backend engineer across edtech, media, and travel client projects. Fixed a
              data-loss race condition on a live broadcast-voting platform, validated at 30,000
              votes/min with zero loss.
            </p>
          </div>
        </div>
        <div class="stop">
          <div class="yr">2016 — 2022</div>
          <div class="role">
            <b>Co-Founder &amp; Software Engineer</b> · <span class="co">Verdant Solution</span>
            <p>
              Co-founded a software studio for the graphic arts industry; designed a Node.js/Python
              microservices platform for print layout optimization.
            </p>
          </div>
        </div>
        <div class="stop">
          <div class="yr">2020 — 2021</div>
          <div class="role">
            <b>Full Stack Developer</b> · <span class="co">NetRacer</span> <span class="tag inline">Freelance</span>
            <p>Automated tournament-results processing from game-output XML, cutting processing time 60%.</p>
          </div>
        </div>
        <div class="stop">
          <div class="yr">2019 — 2021</div>
          <div class="role">
            <b>Software Development Engineer</b> · <span class="co">COMBINATORIA</span>
            <p>Full stack engineer on a maritime operations platform — vessel, cargo, and voyage tracking with Angular and a custom REST API.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact">
      <p class="eyebrow">Contact</p>
      <p class="contact-lead">
        Hiring for a backend or platform role, or need a system that won't fall over? <b>Let's talk.</b>
      </p>
      <div class="clinks">
        <a class="clink" href="mailto:antonuccijulian@gmail.com">✉ <span class="mono">antonuccijulian@gmail.com</span></a>
        <a class="clink" href="https://github.com/JulianNicolas">⌥ <span class="mono">github.com/JulianNicolas</span></a>
        <a class="clink" href="https://www.linkedin.com/in/julian-antonucci/">in <span class="mono">linkedin.com/in/julian-antonucci</span></a>
        <a class="clink" href="#">↓ <span class="mono">Résumé — PDF</span></a>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot-in">
      <span>© 2026 Julián Antonucci — shulian.dev</span>
      <span class="mono">Built with Astro · deployed on Vercel</span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('themeBtn');
      var root = document.documentElement;
      function current() {
        var t = root.getAttribute('data-theme');
        if (t) return t;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('shulian-theme', next);
        } catch (e) {}
      });
    })();
  </script>
</Base>

<style is:global>
  /* ---------- tokens: light (bare :root = full palette) ---------- */
  :root {
    --ground: #f4f5f8;
    --surface: #ffffff;
    --surface-sunk: #edeff3;
    --ink: #14181f;
    --ink-soft: #3b434f;
    --muted: #626c7a;
    --hairline: #dce0e8;
    --hairline-2: #c9cfda;
    --accent: #1e5fcc;
    --accent-ink: #17408a;
    --good: #1c8f63;
    --warn: #b3730e;
    --shadow: 0 1px 2px rgba(20, 24, 31, 0.05), 0 8px 28px -12px rgba(20, 24, 31, 0.14);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --ground: #0e1116;
      --surface: #151a21;
      --surface-sunk: #11151b;
      --ink: #e8ebf1;
      --ink-soft: #c2c9d4;
      --muted: #8c97a6;
      --hairline: #262c36;
      --hairline-2: #333b47;
      --accent: #6098f6;
      --accent-ink: #a9c6fb;
      --good: #3fb784;
      --warn: #d69537;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 12px 34px -14px rgba(0, 0, 0, 0.6);
    }
  }
  :root[data-theme='dark'] {
    --ground: #0e1116;
    --surface: #151a21;
    --surface-sunk: #11151b;
    --ink: #e8ebf1;
    --ink-soft: #c2c9d4;
    --muted: #8c97a6;
    --hairline: #262c36;
    --hairline-2: #333b47;
    --accent: #6098f6;
    --accent-ink: #a9c6fb;
    --good: #3fb784;
    --warn: #d69537;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 12px 34px -14px rgba(0, 0, 0, 0.6);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  img,
  svg {
    max-width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      transition: none !important;
      animation: none !important;
    }
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-weight: 400;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .mono {
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ---------- top bar ---------- */
  header.bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }
  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
  }
  .wordmark {
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 0.98rem;
    color: var(--ink);
  }
  .wordmark .dot {
    color: var(--accent);
  }
  nav.top {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  nav.top a {
    color: var(--muted);
    font-size: 0.82rem;
  }
  nav.top a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .theme-btn {
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    background: var(--surface);
    color: var(--muted);
    border: 1px solid var(--hairline-2);
    border-radius: 6px;
    padding: 4px 9px;
    line-height: 1;
  }
  .theme-btn:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  @media (max-width: 620px) {
    nav.top a.nav-hide {
      display: none;
    }
  }

  /* ---------- eyebrow ---------- */
  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 26px;
  }
  .eyebrow::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  section {
    padding: 68px 0;
    border-top: 1px solid var(--hairline);
  }
  main.wrap > section:first-of-type {
    border-top: 0;
  }

  /* ---------- hero ---------- */
  .hero {
    padding: 74px 0 60px;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 3.7rem);
